# Optional: required only for document chat. Comparison runs locally.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# The public embedding models used by this app do not require a token.
# Optional: set HF_TOKEN if using private or gated Hugging Face models.
HF_TOKEN=

# Optional local model overrides (different models may need more RAM).
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
